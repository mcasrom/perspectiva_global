# -------------------------
# Configuración Base
# -------------------------
baseURL: "https://mcasrom.github.io/perspectiva_global/"
languageCode: "es-es"
defaultContentLanguage: "es"
title: "Perspectiva Global | Crónicas del Nuevo Orden"
theme: "PaperMod"

# -------------------------
# URLs y estructura
# -------------------------
canonifyURLs: true
relativeURLs: false
uglyURLs: false

# -------------------------
# Salidas del sitio
# -------------------------
outputs:
  home:
    - HTML
    - RSS
    - JSON
  section:
    - HTML
    - RSS

# -------------------------
# Git e Info
# -------------------------
enableGitInfo: true

# -------------------------
# Parámetros del tema
# -------------------------
params:
  env: "production"
  siteName: "Perspectiva Global"
  title: "Perspectiva Global"
  author: "M.Castillo"
  description: "Análisis soberano sobre geopolítica, tecnología y el nuevo orden multipolar."

  keywords:
    - geopolítica
    - geoestrategia
    - soberanía tecnológica
    - inteligencia artificial
    - nuevo orden mundial

  # FECHAS
  ShowLastMod: true
  DateFormat: "02 Jan 2006"

  # APARIENCIA
  defaultTheme: "dark"
  disableThemeToggle: false
  ShowReadingTime: true
  showCodeCopyButtons: true
  ShowBreadCrumbs: true
  ShowPostNavLinks: true
  ShowFullTextinRSS: true
  disableSpecial1stPost: true
  disableScrollToTop: false

  # -------------------------
  # ASSETS (FAVICON) - Deben estar en /static/
  # -------------------------
  assets:
    favicon: "/favicon.png"
    favicon16x16: "/favicon.png"
    favicon32x32: "/favicon.png"
    apple_touch_icon: "/favicon.png"

  # -------------------------
  # OPENGRAPH (PREVIEW) - URL ABSOLUTA OBLIGATORIA
  # -------------------------
  images: 
    - "https://mcasrom.github.io/perspectiva_global/images/preview.jpg"
  
  SocialMetadata:
    twitter: "summary_large_image"

  # -------------------------
  # PROFILE MODE (HOME)
  # -------------------------
  profileMode:
    enabled: true
    title: "El Mapa y El Código"
    subtitle: >
      Perspectiva Global: Crónicas del Nuevo Orden.<br>
      <strong>Soberanía tecnológica e inteligencia geopolítica.</strong>
    imageUrl: "images/blog.jpg"
    imageWidth: 250
    imageHeight: 250
    buttons:
      - name: "📂 Ver Análisis"
        url: "posts"
      - name: "🌐 Geo-IA"
        url: "https://mcasrom.github.io/geo-ia/"
      - name: "📚 Daily Readings"
        url: "https://mcasrom.github.io/daily_readings/"
      - name: "☁️ Word Analysis"
        url: "https://mcasrom.github.io/daily_readings/cloud_word.html"

  # -------------------------
  # ICONOS SOCIALES
  # -------------------------
  socialIcons:
    - name: "github"
      url: "https://github.com/mcasrom"
    - name: "rss"
      url: "index.xml"

# -------------------------
# Menú principal
# -------------------------
menu:
  main:
    - name: "Análisis"
      url: "posts/"
      weight: 10
    - name: "Buscar"
      url: "search/"
      weight: 20
    - name: "Acerca de"
      url: "about/"
      weight: 30
    - name: "Contacto"
      url: "contact/"
      weight: 40

# -------------------------
# Markdown / HTML
# -------------------------
markup:
  goldmark:
    renderer:
      unsafe: true
