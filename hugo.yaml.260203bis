baseURL: "https://mcasrom.github.io/perspectiva_global/"
languageCode: "es-es"
defaultContentLanguage: "es"          # OPCIONAL – útil si algún día añades EN
title: "Perspectiva Global | Crónicas del Nuevo Orden"
theme: "PaperMod"

# -------------------------
# URLs y estructura
# -------------------------
canonifyURLs: true
relativeURLs: false
uglyURLs: false

# -------------------------
# Salidas del sitio
# -------------------------
outputs:
  home:
    - HTML
    - RSS
    - JSON        # Necesario para búsqueda PaperMod
  section:        # OPCIONAL – mejora RSS por secciones
    - HTML
    - RSS

# -------------------------
# Git (IMPORTANTE para timestamps automáticos)
# -------------------------
enableGitInfo: true   # Necesario para usar fecha del último commit

# -------------------------
# Parámetros del tema
# -------------------------
params:
  env: "production"
  siteName: "Perspectiva Global"   # SEO
  title: "Perspectiva Global"
  author: "M.Castillo"

  description: "Análisis soberano sobre geopolítica, tecnología y el nuevo orden multipolar."

  keywords:                         # OPCIONAL pero recomendable
    - geopolítica
    - geoestrategia
    - soberanía tecnológica
    - inteligencia artificial
    - nuevo orden mundial

  # -------------------------
  # FECHAS / TIMESTAMPS
  # -------------------------
  ShowLastMod: true                 # 🔹 Activa “Última actualización”
  DateFormat: "02 Jan 2006"         # Formato consistente

  # -------------------------
  # Apariencia
  # -------------------------
  defaultTheme: "dark"
  disableThemeToggle: false
  ShowReadingTime: true
  showCodeCopyButtons: true
  ShowBreadCrumbs: true
  ShowPostNavLinks: true
  ShowFullTextinRSS: true           # OPCIONAL – RSS editorial completo

  disableSpecial1stPost: true       # OPCIONAL – evita post “destacado”
  disableScrollToTop: false         # OPCIONAL

  # -------------------------
  # Assets / OpenGraph
  # -------------------------
  assets:
    favicon: "favicon.png"
    favicon16x16: "favicon.png"
    favicon32x32: "favicon.png"
    apple_touch_icon: "favicon.png"

  images: ["images/preview.jpg"]    # Imagen OG por defecto
  defaultImage: "images/preview.jpg" # OPCIONAL – refuerzo OG

  SocialMetadata:
    twitter: "summary_large_image"

  # -------------------------
  # Profile Mode (HOME)
  # -------------------------
  profileMode:
    enabled: true
    title: "El Mapa y El Código"
    subtitle: >
      Perspectiva Global: Crónicas del Nuevo Orden.<br>
      <strong>Soberanía tecnológica e inteligencia geopolítica.</strong>
    imageUrl: "images/blog.jpg"
    imageWidth: 250
    imageHeight: 250
    buttons:
      - name: "📂 Ver Análisis"
        url: "posts"
      - name: "🌐 Geo-IA"
        url: "https://mcasrom.github.io/geo-ia/"
      - name: "📚 Daily Readings"
        url: "https://mcasrom.github.io/daily_readings/"
      - name: "☁️ Word Analysis"
        url: "https://mcasrom.github.io/daily_readings/cloud_word.html"

  # -------------------------
  # Iconos sociales
  # -------------------------
  socialIcons:
    - name: "github"
      url: "https://github.com/mcasrom"
    - name: "rss"
      url: "index.xml"

# -------------------------
# Menú principal
# -------------------------
menu:
  main:
    - name: "Análisis"
      url: "posts/"
      weight: 10
    - name: "Buscar"
      url: "search/"
      weight: 20
    - name: "Acerca de"
      url: "about/"
      weight: 30
    - name: "Contacto"
      url: "contact/"
      weight: 40

# -------------------------
# Markdown / HTML
# -------------------------
markup:
  goldmark:
    renderer:
      unsafe: true   # Necesario para HTML en subtitle
